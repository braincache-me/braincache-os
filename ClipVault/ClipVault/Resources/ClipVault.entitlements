<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <false/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Hardened Runtime resource access: voice transcription records mic audio
         via AVAudioEngine. Without this entitlement macOS silently denies the
         access — the app never appears in System Settings → Privacy →
         Microphone, and AVCaptureDevice.requestAccess(for: .audio) returns
         without prompting. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Required so Sparkle's notarized helper bundles (Updater.app, Autoupdate)
         can load inside our Hardened Runtime container; they are signed by
         Sparkle, not by our team. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
